rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Triage reports: anyone can read (EOC board), only authenticated users can write
    match /triage_reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['severity', 'location', 'timestamp'])
        && request.resource.data.severity is string
        && request.resource.data.location is string;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
