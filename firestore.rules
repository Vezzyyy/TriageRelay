rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // triage_reports: public read for EOC board; authenticated write with strict field validation
    match /triage_reports/{reportId} {
      allow read: if true;

      allow create: if request.auth != null
        // Required structural fields must be present
        && request.resource.data.keys().hasAll([
             'report_id', 'severity', 'hazard_type',
             'scrubbed_summary', 'pii_scrubbed',
             'created_offline_at', 'sync_status', 'inference_source'
           ])
        // PII must be confirmed scrubbed before cloud write
        && request.resource.data.pii_scrubbed == true
        // Enum constraints
        && request.resource.data.severity in ['CRITICAL', 'URGENT', 'STABLE']
        && request.resource.data.hazard_type in [
             'STRUCTURAL_COLLAPSE', 'FLASH_FLOOD',
             'MEDICAL_EMERGENCY', 'FIRE_HAZARD', 'BLOCKED_ACCESS'
           ]
        && request.resource.data.sync_status in ['QUEUED_OFFLINE', 'SYNCED']
        // Payload size cap: scrubbed summary <= 2000 chars to prevent abuse
        && request.resource.data.scrubbed_summary is string
        && request.resource.data.scrubbed_summary.size() <= 2000
        // report_id must be a non-empty string
        && request.resource.data.report_id is string
        && request.resource.data.report_id.size() > 0;

      // Allow coordinator to toggle verification and sync status only
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['verified_by_coordinator', 'coordinator_notes', 'sync_status', 'corroborated_count']);

      // Allow authenticated users to delete (Clear All)
      allow delete: if request.auth != null;
    }

    // Deny all access to every other collection by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
